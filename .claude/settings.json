{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go mod *)",
      "Bash(go get *)",
      "Bash(go fmt *)",
      "Bash(go env *)",
      "Bash(gofmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/sessions/**)",
      "Bash(cat ~/.claude/.credentials.json*)",
      "Bash(cat *sessions/*.key*)"
    ]
  }
}
